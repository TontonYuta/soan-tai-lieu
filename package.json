{
  "name": "yuta-latex-math-studio",
  "version": "1.0.1",
  "description": "Hệ Thống Soạn Thảo Toán Học Chuẩn LaTeX & Tự Động Hóa 1-Click",
  "author": "Tonton Yuta <contact@yuta.edu.vn>",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build && npm run build:electron:server",
    "build:electron:server": "esbuild server/serverCore.ts --bundle --platform=node --format=cjs --outfile=electron/server.cjs --external:playwright-core --external:localtunnel --external:pdf-parse --external:electron",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "generate:icons": "node scripts/generate_icons.cjs",
    "electron:dev": "npm run build && electron electron/main.cjs --no-sandbox",
    "build:linux": "npm run build && electron-builder --linux --x64",
    "build:appimage": "npm run build && electron-builder --linux AppImage",
    "build:deb": "npm run build && electron-builder --linux deb",
    "build:dir": "npm run build && electron-builder --linux dir --x64"
  },
  "build": {
    "appId": "com.yuta.latexstudio",
    "productName": "Yuta Latex Math Studio",
    "executableName": "yuta-latex-math-studio",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/playwright-core/**/*",
      "icon.svg",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "dir"
      ],
      "maintainer": "Tonton Yuta <contact@yuta.edu.vn>",
      "category": "Education"
    }
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "localtunnel": "^2.0.2",
    "lucide-react": "^0.562.0",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.62.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
